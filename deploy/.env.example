# Sample environment file for deploy/docker-compose.mullvad.yml.
# Copy to deploy/.env (gitignored) and fill in real values.
#
# How to get the WireGuard secrets:
#   1. Sign in at https://mullvad.net/en/account.
#   2. Open https://mullvad.net/en/account/wireguard-config and click
#      "Generate key". Each generated key counts against Mullvad's
#      5-device cap; revoke an unused one first if you are at the limit.
#   3. Pick any country and download a config. Open the downloaded
#      .conf file in a text editor.
#   4. Copy the value of "PrivateKey =" into MULLVAD_WIREGUARD_PRIVATE_KEY.
#   5. Copy the value of "Address =" (typically two comma-separated
#      values, an IPv4 /32 and an IPv6 /128) into
#      MULLVAD_WIREGUARD_ADDRESSES.
#
# Per Mullvad's terms of service, this account and these credentials
# are for personal use only. Do not share them with other people or
# resell access. See docs/deployment.md for the full ToS notes.

# Required: never commit real values.
MULLVAD_WIREGUARD_PRIVATE_KEY=replace-me-with-the-PrivateKey-line-from-your-wg-conf
MULLVAD_WIREGUARD_ADDRESSES=10.65.x.x/32,fc00:bbbb:bbbb:bb01::1:xxxx/128

# Optional: cities gluetun is allowed to pick a relay from. Comma-
# separated. Leave at the default to pin to Stockholm. Tunnelsmith's
# own [[upstream_pool]] country filter is independent of this; gluetun
# only needs to be inside any one Mullvad WG relay so the SOCKS5 mesh
# is reachable.
MULLVAD_SERVER_CITIES=Stockholm

# Optional: which Tunnelsmith image to run. Defaults to the latest
# tagged GHCR image. CI overrides this to use the freshly-built local
# image.
TUNNELSMITH_IMAGE=ghcr.io/pacnpal/tunnelsmith:latest

# Optional: log level for the Tunnelsmith binary. debug | info | warn | error.
TUNNELSMITH_LOG_LEVEL=info
